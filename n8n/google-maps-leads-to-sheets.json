{
  "name": "Find local business leads on Google Maps and save them to Google Sheets",
  "nodes": [
    {
      "id": "782d277d-5d74-42a2-a1a5-20c70c47157f",
      "name": "Receive lead search request",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        96
      ],
      "parameters": {
        "formTitle": "Find local business leads",
        "formDescription": "Searches Google Maps and saves the businesses it finds to your Google Sheet. One search returns up to about 120 places.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Business type",
              "fieldType": "text",
              "placeholder": "e.g. dentists",
              "requiredField": true
            },
            {
              "fieldLabel": "Location",
              "fieldType": "text",
              "placeholder": "e.g. Boulder CO",
              "requiredField": true
            },
            {
              "fieldLabel": "Number of leads",
              "fieldType": "number",
              "defaultValue": "20",
              "requiredField": true
            },
            {
              "fieldLabel": "Country",
              "fieldType": "dropdown",
              "defaultValue": "us",
              "fieldOptions": {
                "values": [
                  {
                    "option": "us"
                  },
                  {
                    "option": "gb"
                  },
                  {
                    "option": "ca"
                  },
                  {
                    "option": "au"
                  },
                  {
                    "option": "de"
                  },
                  {
                    "option": "fr"
                  },
                  {
                    "option": "es"
                  },
                  {
                    "option": "it"
                  },
                  {
                    "option": "in"
                  },
                  {
                    "option": "mx"
                  },
                  {
                    "option": "br"
                  },
                  {
                    "option": "jp"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "buttonLabel": "Find leads"
        }
      },
      "webhookId": "bade5e9d-886a-410b-afab-913230929b4c"
    },
    {
      "id": "85176a0b-6c50-450f-8cad-c69dfcf6480b",
      "name": "Search Google Maps",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "actorSource": "store",
        "actorId": {
          "__rl": true,
          "mode": "id",
          "value": "muhammadafzal~google-maps-scraper"
        },
        "actorInputMode": "json",
        "customBody": "={{ JSON.stringify({ searchQueries: [$json[\"Business type\"].trim() + \" in \" + $json[\"Location\"].trim()], maxResults: Math.min(Math.max(Number($json[\"Number of leads\"]) || 20, 1), 200), countryCode: $json.Country || \"us\", languageCode: \"en\", includePhotos: false, minRating: 0 }) }}",
        "timeout": 600,
        "memory": 256,
        "maxTotalChargeUsd": 1,
        "authentication": "apifyApi"
      },
      "notes": "Runs the Apify Actor muhammadafzal/google-maps-scraper. maxResults is the spending control (about USD 0.004 per place); free Apify plans are capped at 20 places per run. An empty search returns no rows, so this node always outputs an item and the next node routes the empty case.",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "044c76dc-b585-4400-be19-81e365a2ccf1",
      "name": "Lead found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.placeId }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e5abd4b0-5616-40a7-b791-e105ad863cab",
      "name": "Save lead to sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "authentication": "oAuth2",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Local business leads"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "Place ID"
          ],
          "value": {
            "Place ID": "={{ $json.placeId }}",
            "Business": "={{ $json.title }}",
            "Category": "={{ $json.type || \"\" }}",
            "Phone": "={{ $json.phoneNumber || \"\" }}",
            "Website": "={{ $json.website || \"\" }}",
            "Address": "={{ $json.address || \"\" }}",
            "City": "={{ $json.city || \"\" }}",
            "Rating": "={{ $json.rating ?? \"\" }}",
            "Reviews": "={{ $json.ratingCount ?? \"\" }}",
            "Google Maps URL": "={{ $json.googleUrl || \"\" }}",
            "Search": "={{ $json.searchQuery || \"\" }}",
            "Last seen": "={{ $now.toISODate() }}"
          },
          "schema": [
            {
              "id": "Place ID",
              "displayName": "Place ID",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Business",
              "displayName": "Business",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Category",
              "displayName": "Category",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Phone",
              "displayName": "Phone",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Website",
              "displayName": "Website",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Address",
              "displayName": "Address",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "City",
              "displayName": "City",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Rating",
              "displayName": "Rating",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Reviews",
              "displayName": "Reviews",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Google Maps URL",
              "displayName": "Google Maps URL",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Search",
              "displayName": "Search",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Last seen",
              "displayName": "Last seen",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "40fe2c22-5fda-48dd-9178-5bce77100dab",
      "name": "Show saved count",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        896,
        0
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "={{ $input.all().length }} leads saved",
        "completionMessage": "=Search: {{ $(\"Receive lead search request\").first().json[\"Business type\"] }} in {{ $(\"Receive lead search request\").first().json.Location }}. Open your Google Sheet to see the leads. Businesses already in the sheet were updated, not duplicated."
      },
      "executeOnce": true,
      "webhookId": "3455f2fb-22ec-4a97-91ad-fea339e6f4de"
    },
    {
      "id": "7bb6d2ce-950a-4e9e-9ec3-5b2531303529",
      "name": "Show no-results message",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        672,
        192
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "No leads found",
        "completionMessage": "Google Maps returned no businesses for this search, or the search could not be completed. Try a broader business type or a nearby city."
      },
      "executeOnce": true,
      "webhookId": "7487f4c6-8455-4950-b2a3-561c377f2e4b"
    }
  ],
  "connections": {
